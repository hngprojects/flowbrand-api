<tr>
  <td align="left" style="padding: 40px 40px 48px">
    <h1 style="margin: 0 0 28px; font-size: 32px; line-height: 1.2; font-weight: 700; color: #020e1f; letter-spacing: -0.03em">Notification alert</h1>
    <p style="margin: 0 0 20px; font-size: 16px; line-height: 1.55; color: #020e1f">Hi {{name}},</p>
    <p style="margin: 0 0 28px; font-size: 16px; line-height: 1.55; color: #020e1f">You have <strong>{{unreadCount}}</strong> new notification(s) from FlowBrand. Open the app to stay up to date.</p>
    <a href="{{dashboardUrl}}" style="display: inline-block; background-color: #326ad1; color: #ffffff; text-decoration: none; font-size: 16px; font-weight: 600; padding: 14px 32px; border-radius: 6px">View notifications</a>
    <p style="margin: 24px 0 0; font-size: 14px; line-height: 1.5; color: #64748b">To manage your notification preferences, <a href="{{notificationPreferencesUrl}}" style="color: #326ad1; text-decoration: underline">click here</a>.</p>
  </td>
</tr>
