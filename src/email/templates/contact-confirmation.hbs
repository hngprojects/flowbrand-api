<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #ffffff">
  <tr>
    <td align="center" style="padding: 48px 40px 0">
      <img
        src="https://res.cloudinary.com/duuenqnnn/image/upload/v1778947305/Full_logo_nxrfxg.png"
        alt="Seil"
        width="120"
        style="display: block; border: 0; outline: none;"
      />
    </td>
  </tr>
  <tr>
    <td align="left" style="padding: 40px 40px 32px">
      <h1 style="margin: 0 0 28px; font-size: 32px; line-height: 1.2; font-weight: 700; color: #020e1f; letter-spacing: -0.03em">
        We&apos;ve received your message
      </h1>
      <p style="margin: 0 0 20px; font-size: 16px; line-height: 1.55; color: #020e1f">
        Hi {{fullName}},
      </p>
      <p style="margin: 0 0 20px; font-size: 16px; line-height: 1.55; color: #020e1f">
        Thanks for reaching out. We&apos;ve received your message and will get back to you within one business day.
      </p>
      <p style="margin: 0; font-size: 16px; line-height: 1.55; color: #020e1f">
        In the meantime, feel free to explore how Seil can help transform your digital presence into a high-conversion engine.
      </p>
    </td>
  </tr>
  <tr>
    <td align="center" style="padding: 0 40px 48px">
      <p style="margin: 0 0 16px; font-size: 14px; line-height: 1.5; color: #64748b; text-align: center">
        You are receiving this because you contacted us at Seil
      </p>
      <p style="margin: 0 0 16px; text-align: center">
        <a href="{{privacyPolicyUrl}}" style="font-size: 14px; line-height: 1.5; color: #326ad1; text-decoration: underline">
          Privacy Policy
        </a>
      </p>
    </td>
  </tr>
</table>