<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>SEIL</title>
  </head>
  <body style="margin:0;padding:0;background:#f3f4f6;font-family:Arial,sans-serif;">
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background:#f3f4f6;padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:600px;">

            <!-- Header -->
            <tr>
              <td style="background:#3B7BF7;border-radius:10px 10px 0 0;padding:20px 24px;text-align:center;">
                <span style="font-family:Arial,sans-serif;font-size:28px;font-weight:700;color:#ffffff;letter-spacing:-0.5px;">Seil</span>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="background:#ffffff;padding:0;border-radius:0 0 10px 10px;overflow:hidden;">
                {{{body}}}
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="padding:20px 24px;text-align:center;color:#9ca3af;font-size:12px;line-height:1.6;">
                &copy; {{year}} SEIL. All rights reserved.
                <br />
                <a href="{{unsubscribeUrl}}" style="color:#9ca3af;text-decoration:underline;">Unsubscribe</a>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
