<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Seil</title>
  </head>
  <body style="margin: 0; padding: 0; width: 100% !important; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; background-color: #363636; font-family: 'Figtree', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #363636">
      <tr>
        <td align="center" style="padding: 48px 20px">
          <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 480px; background-color: #ffffff">
            <tr>
              <td align="center" style="padding: 48px 40px 0">
                <img
                  src="https://res.cloudinary.com/df4uoreab/image/upload/c_crop,g_north_west,h_1202,w_2164,x_1179,y_1581/Seil_Logo-01_igh4ad.png"
                  alt="Seil"
                  width="45"
                  style="display: block; border: 0; outline: none;"
                />
              </td>
            </tr>
            {{{body}}}
            <tr>
              <td align="center" style="padding: 0 40px 48px">
                <p style="margin: 0 0 16px; font-size: 14px; line-height: 1.5; color: #64748b; text-align: center">
                  You are receiving this because you signed up at Seil
                </p>
                <p style="margin: 0 0 16px; text-align: center">
                  <a href="{{privacyPolicyUrl}}" style="font-size: 14px; line-height: 1.5; color: #326ad1; text-decoration: underline">Privacy Policy</a>
                </p>
                <p style="margin: 0; font-size: 14px; line-height: 1.5; color: #94a3b8; text-align: center">
                  &copy; {{year}} Seil. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
