<tr>
  <td align="left" style="padding: 40px 40px 48px">
    <h1 style="margin: 0 0 28px; font-size: 32px; line-height: 1.2; font-weight: 700; color: #020e1f; letter-spacing: -0.03em">Your weekly progress</h1>
    <p style="margin: 0 0 20px; font-size: 16px; line-height: 1.55; color: #020e1f">Hi {{name}},</p>
    <p style="margin: 0 0 20px; font-size: 16px; line-height: 1.55; color: #020e1f">Here is a quick look at how your funnel is going. You have completed {{completedTasks}} of {{totalTasks}} tasks.</p>
    {{#if activeStageName}}
    <p style="margin: 0 0 20px; font-size: 16px; line-height: 1.55; color: #020e1f">Your active stage right now is &quot;{{activeStageName}}&quot;.</p>
    {{/if}}
    <p style="margin: 0; font-size: 16px; line-height: 1.55; color: #020e1f">Open SEIL to keep building momentum this week.</p>
  </td>
</tr>
