    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 28px; border-collapse: collapse">
      <tr>
        <td style="padding: 12px 0; font-size: 14px; color: #64748b; border-bottom: 1px solid #e2e8f0">Plan</td>
        <td style="padding: 12px 0; font-size: 14px; color: #020e1f; text-align: right; border-bottom: 1px solid #e2e8f0">Pro</td>
      </tr>
      <tr>
        <td style="padding: 12px 0; font-size: 14px; color: #64748b; border-bottom: 1px solid #e2e8f0">Amount</td>
