<tr>
  <td align="left" style="padding: 40px 40px 24px">
    <h1 style="margin: 0 0 12px; font-size: 32px; line-height: 1.2; font-weight: 700; color: #020e1f">Your Verification Code</h1>
    <p style="margin: 0; font-size: 16px; line-height: 1.55; color: #020e1f">Hi {{fullName}}, use the code below to complete your sign in</p>
  </td>
</tr>
<tr>
  <td align="center" style="padding: 0 40px 16px">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 auto">
      <tr>
        <td align="center" style="border: 1px solid #e2e8f0; border-radius: 8px; background-color: #f8fafc; padding: 16px 32px; font-size: 36px; font-weight: 700; color: #020e1f; letter-spacing: 0.25em; white-space: nowrap">{{otpCode}}</td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td align="center" style="padding: 0 40px 12px">
    <p style="margin: 0; font-size: 14px; line-height: 1.5; color: #64748b; text-align: center">This code expires in {{expiryMins}} minutes.</p>
  </td>
</tr>
<tr>
  <td align="center" style="padding: 0 40px 32px">
    <p style="margin: 0; font-size: 14px; line-height: 1.5; color: #64748b; text-align: center">If you didn&apos;t request this, you can ignore this email.</p>
  </td>
</tr>
