<table role="presentation" cellpadding="0" cellspacing="0" width="100%">
  <tr>
    <td style="padding:28px 24px 8px;color:#111827;font-size:22px;font-weight:700;text-align:center;">
      Verify Your Email
    </td>
  </tr>
  <tr>
    <td style="padding:0 24px 8px;color:#4b5563;font-size:15px;line-height:1.6;text-align:center;">
      Hello {{fullName}},
    </td>
  </tr>
  <tr>
    <td style="padding:0 24px 8px;color:#4b5563;font-size:15px;line-height:1.6;text-align:center;">
      Use the code below to verify your account and continue setup.
    </td>
  </tr>
  <tr>
    <td align="center" style="padding:16px 24px;">
      <div style="display:inline-block;
        background:#f9fafb;
        border:1px solid #e5e7eb;
        border-radius:8px;
        padding:12px 24px;
        color:#111827;
        font-size:32px;
        letter-spacing:8px;
        font-weight:700;
        font-family:'Courier New',Courier,monospace;">
        {{otpCode}}
      </div>
    </td>
  </tr>
  <tr>
    <td style="padding:0 24px 28px;color:#6b7280;font-size:13px;line-height:1.6;text-align:center;">
      This code expires in {{expiryMins}} minutes. If you did not create an account, you can safely ignore this email.
    </td>
  </tr>
</table>
