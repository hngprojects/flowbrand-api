<tr>
  <td align="left" style="padding: 40px 40px 48px">
    <h1 style="margin: 0 0 28px; font-size: 32px; line-height: 1.2; font-weight: 700; color: #020e1f; letter-spacing: -0.03em">We couldn&#39;t process your payment</h1>
    <p style="margin: 0 0 20px; font-size: 16px; line-height: 1.55; color: #020e1f">Hi {{name}},</p>
    <p style="margin: 0 0 20px; font-size: 16px; line-height: 1.55; color: #020e1f">We were unable to process your payment for your FlowBrand Pro subscription.</p>
    {{#if failureReason}}
    <p style="margin: 0 0 20px; font-size: 16px; line-height: 1.55; color: #64748b">Reason: {{failureReason}}</p>
    {{/if}}
    <p style="margin: 0 0 28px; font-size: 16px; line-height: 1.55; color: #020e1f">Please update your payment details to continue enjoying FlowBrand Pro.</p>
    <a href="{{upgradeUrl}}" style="display: inline-block; background-color: #326ad1; color: #ffffff; text-decoration: none; font-size: 16px; font-weight: 600; padding: 14px 32px; border-radius: 6px">Update Payment Details</a>
  </td>
</tr>
