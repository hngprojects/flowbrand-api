{{!
  Team Invitation Email Template
  Expected payload: TeamInvitePayload
  Variables: inviteLink, role, teamName, customMessage (optional)
}}

<td align="left" style="padding: 40px 40px 48px">
  <h1 style="margin: 0 0 20px; font-size: 32px; line-height: 1.2; font-weight: 700; color: #020e1f; letter-spacing: -0.03em">
    Team Invitation
  </h1>
  
  <p style="margin: 0 0 20px; font-size: 16px; line-height: 1.55; color: #020e1f">
    Hello,
  </p>
  
  <p style="margin: 0 0 20px; font-size: 16px; line-height: 1.55; color: #020e1f">
    You have been invited to join the <strong style="color: #020e1f">{{teamName}}</strong> team 
    on the SEIL admin portal as a <strong style="color: #020e1f">{{role}}</strong>.
  </p>
  
  {{#if customMessage}}
    <div style="margin: 20px 0; padding: 20px; background-color: #f5f7fa; border-radius: 8px; border-left: 4px solid #3b82f6;">
      <p style="margin: 0; font-size: 15px; line-height: 1.55; color: #4b5563; font-style: italic;">
        "{{customMessage}}"
      </p>
    </div>
  {{/if}}
  
  <p style="margin: 28px 0 20px; text-align: center">
    <a href="{{inviteLink}}" 
       style="display: inline-block; background-color: #3b82f6; color: #ffffff; 
              text-decoration: none; padding: 14px 32px; border-radius: 8px; 
              font-weight: 600; font-size: 16px; text-align: center;
              transition: background-color 0.2s;">
      Accept Invitation
    </a>
  </p>
  
  <p style="margin: 0 0 20px; font-size: 14px; line-height: 1.55; color: #6b7280;">
    This invitation link will expire in <strong>7 days</strong>.
  </p>
  
  <hr style="margin: 32px 0 20px; border: none; border-top: 1px solid #e5e7eb;" />
  
  <p style="margin: 0; font-size: 14px; line-height: 1.55; color: #6b7280;">
    If you weren't expecting this invitation, you can safely ignore this email.
  </p>
</td>