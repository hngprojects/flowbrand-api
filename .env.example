NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=nestjs_starter
DATABASE_SYNC=false
DATABASE_LOGGING=false
DATABASE_SSL=false

# JWT (must be at least 32 characters each)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Misc
CORS_ORIGIN=*
SWAGGER_ENABLED=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=

GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Queue
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=5000
# Parallel jobs per worker. Min 1. Increasing beyond 5 may exhaust Gemini free-tier quota.
QUEUE_CONCURRENCY=3
# Set to true to enable Redis TLS (required in production)
REDIS_TLS=false

# Email delivery (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=SEIL <noreply@seil.app>
EMAIL_QUEUE_CONCURRENCY=5
EMAIL_QUEUE_BACKOFF_DELAY=3000
FRONTEND_URL=http://localhost:3000

CONTACT_ADMIN_EMAIL=useseil@hng14.com
