NODE_ENV=development
PORT=3000
LOG_LEVEL=info                # debug | info | warn | error

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=nestjs_starter
DATABASE_SYNC=false
DATABASE_LOGGING=false
DATABASE_SSL=false

# JWT (must be at least 32 characters each)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Misc
CORS_ORIGIN=*
SWAGGER_ENABLED=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=

GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Queue
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=5000
# Parallel jobs per worker. Min 1. Increasing beyond 5 may exhaust Gemini free-tier quota.
QUEUE_CONCURRENCY=3
# Set to true to enable Redis TLS (required in production)
REDIS_TLS=false

# Email delivery (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=SEIL <noreply@seil.app>
EMAIL_QUEUE_CONCURRENCY=5
EMAIL_QUEUE_BACKOFF_DELAY=3000
FRONTEND_URL=http://localhost:3000

# WRITE — S3 API (local MinIO; on server use DevOps S3 endpoint + credentials)
UPLOAD_STORAGE_ENDPOINT=http://127.0.0.1:9000
UPLOAD_STORAGE_ACCESS_KEY=minioadmin
UPLOAD_STORAGE_SECRET_KEY=minioadmin
UPLOAD_STORAGE_BUCKET=flowbrand-uploads
UPLOAD_STORAGE_REGION=us-east-1
# UPLOAD_STORAGE_PUBLIC_ENDPOINT=https://staging.flowbrand.hng14.com
UPLOAD_STORAGE_PUBLIC_ENDPOINT=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=60000

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=60000
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

ASSEMBLYAI_API_KEY=

CONTACT_ADMIN_EMAIL=useseil@hng14.com

# Admin seeding (used by pnpm seed:admin)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=       # min 8 chars, upper + lower + digit + special char

# Payments (required — no default, missing value causes boot failure)
PAYMENT_PROVIDER=mock      # mock | paystack | flutterwave | stripe
TEST_PAYMENT_OUTCOME=success   # success | failure | pending (mock adapter only)
PRO_PLAN_PRICE_ONETIME_KOBO=   # e.g. 999900 = ₦9,999. Omit to use fallback.
PRO_PLAN_PRICE_MONTHLY_KOBO=   # e.g. 299900 = ₦2,999. Omit to use fallback.
PRO_PLAN_PRICE_ANNUAL_KOBO=    # e.g. 2999900 = ₦29,999. Omit to use fallback.

# Paystack — required when PAYMENT_PROVIDER=paystack. Store in secret manager, not .env.
PAYSTACK_SECRET_KEY=sk_live_   # Server-side secret — used for API calls AND webhook HMAC-SHA512 verification. NEVER expose to client.
PAYSTACK_PUBLIC_KEY=pk_live_   # Client-side key — safe in frontend
PAYSTACK_PRO_MONTHLY_PLAN_CODE=PLN_   # Monthly PRO subscription plan code (create in Paystack dashboard)
PAYSTACK_PRO_ANNUAL_PLAN_CODE=PLN_    # Annual PRO subscription plan code (create in Paystack dashboard)
